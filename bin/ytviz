#!/usr/bin/env python3
# ytviz — real spectrum bars from whatever is playing, stdlib only.
#
# Records the default sink's monitor via pw-record and runs a Goertzel filter
# bank (10 log-spaced bands) over each chunk. Prints one line of 10 integers
# (0-100) per ~46ms frame. Adaptive per-band peaks keep quiet passages alive.
# Exits non-zero when no monitor exists so callers can fall back to a pulse.
import math
import re
import select
import signal
import struct
import subprocess
import sys

RATE = 22050
CHUNK = 1024
BANDS = [60, 120, 250, 500, 1000, 2000, 4000, 6000, 9000, 12000]
NBANDS = len(BANDS)
# Pactl identifiers are dot-separated node names; reject anything else so a
# malformed/spoofed pactl line can never become a --target value.
_SINK_RE = re.compile(r"^[A-Za-z0-9_.:-]+$")
_MONITOR_RE = re.compile(r"^[A-Za-z0-9_.:-]+\.monitor$")
# Silence timeout (s) for one audio chunk: a suspended/hung source must not
# hang us forever in a blocking pipe read.
READ_TIMEOUT = 5.0
# Warm-start floor for adaptive peaks: 1e-9 made frame 1 mag/peak == 1 ->
# 0dB -> v=100 (0->100 jump). 1.0 is a small realistic quiet-room floor
# (white-noise sigma~32 => sigma^2/N ~ 1.0) so frame 1 cannot be 100 once
# attack-smoothing + startup ramp are applied below.
_PEAK_FLOOR = 1.0
# Attack smoothing (fast attack kept) + startup ramp length. Release 0.82
# preserved in main loop for fast-attack / slow-release character.
_ATTACK_SMOOTH = 0.45
_STARTUP_RAMP_FRAMES = 8
# Precomputed Goertzel coefficients per band.
_COEFFS = [2.0 * math.cos(2.0 * math.pi * f / RATE) for f in BANDS]


def default_monitor():
    # Robust monitor resolution: enumerate `pactl list short sources` for
    # *.monitor first. Prefer the default sink's monitor when identifiable,
    # otherwise the first .monitor. Return the numeric source id — pw-record
    # --target reliably accepts the id, while the ".monitor" node-name string
    # fails on PipeWire 1.6.x ("no target node available").
    # Fallback chain: enumerated id -> constructed "sink.monitor" (best effort
    # when enumeration itself failed) -> None (exit non-zero with clear stderr).
    try:
        default_sink = subprocess.check_output(
            ["pactl", "get-default-sink"], text=True, timeout=2
        ).strip() or None
    except Exception:
        default_sink = None
    if default_sink and not _SINK_RE.match(default_sink):
        default_sink = None
    monitors = []  # list of (id, name)
    listed = False
    try:
        out = subprocess.check_output(
            ["pactl", "list", "short", "sources"], text=True, timeout=2
        )
        listed = True
        for line in out.splitlines():
            parts = line.split()
            if len(parts) >= 2:
                sid, name = parts[0], parts[1]
                # Numeric id + well-shaped monitor name only; skip malformed
                # lines (empty fields, headers, wrapped rows) outright.
                if sid.isdigit() and _MONITOR_RE.match(name):
                    monitors.append((sid, name))
    except Exception:
        listed = False
        monitors = []
    if monitors:
        if default_sink:
            want = default_sink + ".monitor"
            for sid, name in monitors:
                if name == want:
                    return sid
            for sid, name in monitors:
                if name.startswith(default_sink):
                    return sid
        return monitors[0][0]
    if listed:
        # Enumeration worked but no monitors exist: fail fast, don't guess.
        return None
    if default_sink:
        return default_sink + ".monitor"
    return None


def goertzel(samples, coeff):
    s0 = s1 = s2 = 0.0
    for x in samples:
        s0 = x + coeff * s1 - s2
        s2 = s1
        s1 = s0
    return s1 * s1 + s2 * s2 - coeff * s1 * s2


def main():
    # TERM must run the finally-cleanup below: default SIGTERM would kill us
    # without reaping pw-record, orphaning it (viz-test `timeout -s TERM`
    # leftovers). Raising SystemExit routes through finally -> kill + wait.
    def _on_term(signum, frame):
        raise SystemExit(128 + signum)
    try:
        signal.signal(signal.SIGTERM, _on_term)
    except Exception:
        pass
    monitor = default_monitor()
    if not monitor:
        sys.stderr.write("ytviz: no monitor source found (pactl list short sources has no *.monitor)\n")
        return 1
    try:
        rec = subprocess.Popen(
            ["pw-record", "--target", monitor, "--format", "s16",
             "--rate", str(RATE), "--channels", "1", "-"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
        )
    except Exception as e:
        sys.stderr.write("ytviz: pw-record failed: %s\n" % e)
        return 1
    frame_bytes = CHUNK * 2
    peaks = [_PEAK_FLOOR] * NBANDS
    disp = [0.0] * NBANDS
    lines = 0
    try:
        while True:
            # Bounded wait: select returns readable on EOF too, so a dead
            # pw-record still falls through to read -> break. A live but
            # silent source trips the timeout instead of hanging forever.
            try:
                ready, _, _ = select.select([rec.stdout], [], [], READ_TIMEOUT)
            except Exception:
                break
            if not ready:
                sys.stderr.write(
                    "ytviz: timed out waiting for audio data from target %s\n" % monitor)
                break
            raw = rec.stdout.read(frame_bytes)
            if not raw or len(raw) < frame_bytes:
                break
            samples = struct.unpack("<%dh" % CHUNK, raw)
            out = []
            for b in range(NBANDS):
                mag = goertzel(samples, _COEFFS[b]) / (CHUNK * CHUNK)
                if mag > peaks[b]:
                    peaks[b] = mag
                else:
                    # Never decay below the realistic floor: after long
                    # silence peaks must not sink back to ~0 and re-arm a
                    # 0->100 jump on the next loud frame.
                    peaks[b] = max(peaks[b] * 0.9995, _PEAK_FLOOR)
                # -60dB floor -> 0, peak -> 100
                db = 10.0 * math.log10(mag / (peaks[b] + 1e-12) + 1e-9)
                v = max(0.0, min(100.0, (db + 60.0) * 100.0 / 60.0))
                # fast attack (smoothed, no instant 0->100 jump), slow release
                if v > disp[b]:
                    disp[b] += (v - disp[b]) * _ATTACK_SMOOTH
                else:
                    disp[b] *= 0.82
                # Startup ramp: frame 1 * 1/8, ..., frame 8+ * 1. Even a
                # full-scale v=100 yields ~5 on frame 1 (45*0.125), rising
                # smoothly to full scale by frame 8. Uses (lines+1) so the
                # first frame is small-but-nonzero instead of all-zero.
                ramp = min(1.0, (lines + 1) / float(_STARTUP_RAMP_FRAMES))
                out.append(str(int(max(0.0, min(100.0, disp[b] * ramp)))))
            sys.stdout.write(" ".join(out) + "\n")
            sys.stdout.flush()
            lines += 1
    except (BrokenPipeError, KeyboardInterrupt):
        pass
    finally:
        # Close the pipe first so a blocked read/EOF resolves, then SIGKILL +
        # reap. Second kill/wait covers the (rare) wait-timeout path so no
        # zombie survives a TERM/INT.
        try:
            if rec.stdout:
                try:
                    rec.stdout.close()
                except Exception:
                    pass
        except Exception:
            pass
        try:
            rec.kill()
        except Exception:
            pass
        try:
            rec.wait(timeout=2)
        except Exception:
            try:
                rec.kill()
            except Exception:
                pass
            try:
                rec.wait(timeout=2)
            except Exception:
                pass
    if lines == 0:
        # pw-record died immediately (bad target) or yielded no frames:
        # silent success would leave callers idling on zero bars. Fail loudly
        # so viz-test and BarWidget fall back to idle pulse.
        try:
            rc = rec.poll()
        except Exception:
            rc = None
        sys.stderr.write("ytviz: no audio data from target %s (pw-record rc=%s)\n" % (monitor, rc))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
